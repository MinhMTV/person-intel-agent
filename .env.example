# Copy to .env and adjust. NEVER commit real credentials.

# --- Application ---------------------------------------------------------------
# development | production
APP_ENV=development
# keep local unless behind an authenticated reverse proxy
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Shared secret required for every /api call when set (header X-API-Token or login cookie).
# Strongly recommended whenever HOST is not 127.0.0.1.
APP_API_TOKEN=
# comma-separated; empty = same-origin only
CORS_ORIGINS=
# mutating API calls per client IP
RATE_LIMIT_PER_MINUTE=30

DATA_DIR=./data
# default sqlite:///./data/person_intel.db (only SQLite is implemented)
DATABASE_URL=

# --- Uploads & fetching ----------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_REFERENCE_IMAGES=5
MAX_REMOTE_IMAGE_MB=8
MAX_REMOTE_PAGE_MB=3
MAX_IMAGES_PER_PAGE=4
MAX_CANDIDATE_PAGES=40
# seconds; partial results are kept when reached
INVESTIGATION_TIMEOUT=180
# honour HTTP(S)_PROXY for outbound requests
OUTBOUND_USE_ENV_PROXY=true

# --- Face matching ------------------------------------------------------------------
FACE_MODEL=ArcFace
# DeepFace detector backend (opencv, retinaface, mtcnn, …)
FACE_DETECTOR=opencv
# ArcFace cosine-distance bands. FACE_MATCH_THRESHOLD is DeepFace's ArcFace
# verification threshold; the tighter bands are heuristics, NOT probabilities.
FACE_VERY_HIGH_THRESHOLD=0.40
FACE_HIGH_THRESHOLD=0.55
FACE_MATCH_THRESHOLD=0.68
FACE_LOW_THRESHOLD=0.80

# --- Reverse image providers ------------------------------------------------------------
GOOGLE_VISION_ENABLED=false
# either an API key …
GOOGLE_VISION_API_KEY=
# … or a service-account JSON path (pip install google-auth)
GOOGLE_APPLICATION_CREDENTIALS=
TINEYE_ENABLED=false
TINEYE_API_URL=https://api.tineye.com/rest/
TINEYE_API_KEY=

# --- Parameter-assisted discovery ----------------------------------------------------
SEARXNG_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_ENGINES=google,duckduckgo,startpage,bing
DDGS_ENABLED=true
GITHUB_ENABLED=true
GITHUB_TOKEN=
WIKIDATA_ENABLED=true
# image-only searches: use Google's web entity as a search hint
USE_WEB_ENTITY_HINTS=true

# --- Leads (hypotheses — disabled by default) ---------------------------------------
GENERATE_EMAIL_CANDIDATES=false
SMTP_VERIFICATION_ENABLED=false
GENERATE_DOMAIN_CANDIDATES=false
HIBP_API_KEY=

# --- Browser sessions (LinkedIn/Xing cookies) — local use only ------------------------
SESSION_MANAGEMENT_ENABLED=false
SESSION_PERSISTENCE_ENABLED=false
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# --- Retention ------------------------------------------------------------------------------
REFERENCE_IMAGE_RETENTION_HOURS=24
REFERENCE_EMBEDDING_RETENTION_HOURS=24
FACE_THUMBNAIL_RETENTION_DAYS=30
